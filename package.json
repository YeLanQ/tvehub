{
  "name": "three-visual-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:layers": "node scripts/check-layers.mjs",
    "build": "vue-tsc --noEmit && node scripts/check-layers.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "smoke:mesh": "vite build --ssr scripts/smoke-mesh.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-mesh.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "monaco-editor": "0.52.2",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "typescript": "~5.6.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.103.1",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
