{
  "name": "three-visual-editor",
  "private": true,
  "version": "0.1.3+1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-version.mjs && vitest run && vite",
    "check:layers": "node scripts/check-layers.mjs",
    "build": "node scripts/sync-version.mjs && node scripts/build-runtime.mjs && node scripts/gen-web-preview-files.mjs && node scripts/sync-licenses.mjs && node scripts/gen-lan-theme.mjs && vue-tsc --noEmit && node scripts/check-layers.mjs && vitest run && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:portable": "tauri build",
    "smoke": "node scripts/smoke/runner.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:test-model": "vite build --ssr scripts/gen-test-model.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/gen-test-model.js",
    "gen:preview-files": "node scripts/gen-web-preview-files.mjs",
    "gen:licenses": "node scripts/sync-licenses.mjs",
    "qr:check": "node scripts/qr-selfcheck-run.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:bump": "node scripts/sync-version.mjs bump"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "draco3dgltf": "^1.5.7",
    "jolt-physics": "^1.1.0",
    "monaco-editor": "0.52.2",
    "three": "^0.185.1",
    "typescript": "~5.6.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "^26.6.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "meshoptimizer": "^1.2.0",
    "sass": "^1.103.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.1.10"
  }
}
