{
  "name": "three-visual-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:layers": "node scripts/check-layers.mjs",
    "build": "node scripts/gen-web-preview-files.mjs && vue-tsc --noEmit && node scripts/check-layers.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:portable": "tauri build",
    "smoke:mesh": "vite build --ssr scripts/smoke-mesh.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-mesh.js",
    "smoke:physics": "vite build --ssr scripts/smoke-physics.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-physics.js",
    "smoke:physics-runtime": "node scripts/smoke-physics-runtime.mjs",
    "smoke:collider": "vite build --ssr scripts/smoke-collider-helper.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-collider-helper.js",
    "smoke:components": "vite build --ssr scripts/smoke-components.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-components.js",
    "smoke:shader": "vite build --ssr scripts/smoke-shader.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-shader.js",
    "smoke:shader-runtime": "node scripts/smoke-shader-runtime.mjs",
    "smoke:shadow": "vite build --ssr scripts/smoke-shadow.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-shadow.js",
    "smoke:shadow-runtime": "node scripts/smoke-shadow-runtime.mjs",
    "smoke:node-menu": "vite build --ssr scripts/smoke-node-menu.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-node-menu.js",
    "smoke:asset-menu": "vite build --ssr scripts/smoke-asset-menu.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-asset-menu.js",
    "smoke:model-draco": "vite build --ssr scripts/smoke-model-draco.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-model-draco.js",
    "gen:test-model": "vite build --ssr scripts/gen-test-model.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/gen-test-model.js",
    "smoke:materials": "vite build --ssr scripts/smoke-materials.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-materials.js",
    "smoke:layers": "vite build --ssr scripts/smoke-layers.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-layers.js",
    "smoke:layers-runtime": "node scripts/smoke-layers-runtime.mjs",
    "smoke:particles": "vite build --ssr scripts/smoke-particles.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-particles.js",
    "smoke:particles-runtime": "node scripts/smoke-particles-runtime.mjs",
    "smoke:terrain": "vite build --ssr scripts/smoke-terrain.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-terrain.js",
    "smoke:fog": "vite build --ssr scripts/smoke-fog.ts --outDir .tmp-smoke --emptyOutDir && node .tmp-smoke/smoke-fog.js",
    "smoke:tween-runtime": "node scripts/smoke-tween-runtime.mjs",
    "smoke:script-hooks": "node scripts/smoke-script-hooks.mjs",
    "smoke:runtime-modules": "node scripts/smoke-runtime-modules.mjs",
    "gen:preview-files": "node scripts/gen-web-preview-files.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "draco3dgltf": "^1.5.7",
    "jolt-physics": "^1.1.0",
    "monaco-editor": "0.52.2",
    "three": "^0.185.1",
    "typescript": "~5.6.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/draco3dgltf": "^1.4.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "meshoptimizer": "^1.2.0",
    "sass": "^1.103.1",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
