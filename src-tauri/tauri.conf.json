{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TvE Hub",
  "mainBinaryName": "TvE Hub",
  "version": "0.1.0+1",
  "identifier": "TvE.Hub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "home",
        "title": "TvE Hub",
        "width": 1300,
        "height": 860,
        "minWidth": 1300,
        "minHeight": 860,
        "visible": false,
        "url": "home.html",
        "backgroundColor": "#000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force-high-performance-gpu"
      },
      {
        "label": "main",
        "title": "TvE Editor",
        "width": 1300,
        "height": 860,
        "minWidth": 1300,
        "minHeight": 860,
        "visible": false,
        "url": "index.html",
        "backgroundColor": "#000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force-high-performance-gpu"
      },
      {
        "label": "graph",
        "title": "TvE Graph",
        "width": 1300,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "url": "graph.html",
        "backgroundColor": "#000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force-high-performance-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Tve Team",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
