{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "three-visual-editor",
  "version": "0.1.0",
  "identifier": "three-visual-editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "home",
        "title": "TVE Manager",
        "width": 1300,
        "height": 860,
        "minWidth": 1300,
        "minHeight": 860,
        "visible": false,
        "url": "home.html",
        "backgroundColor": "#000"
      },
      {
        "label": "main",
        "title": "TVE Editor",
        "width": 1300,
        "height": 860,
        "minWidth": 1300,
        "minHeight": 860,
        "visible": false,
        "url": "index.html",
        "backgroundColor": "#000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
